# 생성 LLM 제공자/모델은 후속 구현에서 선택합니다. 임베딩 모델과 별개입니다.
LLM_PROVIDER=
LLM_MODEL=

# 공개 로컬 임베딩. 사용자 지정 모델이며 검색 품질은 아직 검증하지 않았습니다.
EMBEDDING_MODEL=BAAI/bge-m3

# OpenAI를 생성 LLM으로 선택할 때만 필요합니다.
OPENAI_API_KEY=

# Tavily 웹 검색 기능을 구현하고 사용할 때만 필요합니다.
TAVILY_API_KEY=

# Ollama 로컬 서버의 주소를 기본값과 다르게 쓸 때만 설정합니다. 로컬 서버는 보통 API 키가 없습니다.
# 설치된 Ollama Python 클라이언트가 OLLAMA_HOST를 읽습니다. 별도 OLLAMA_BASE_URL 변수는 쓰지 않습니다.
OLLAMA_HOST=

# LangSmith 추적은 선택 사항입니다. 켤 때만 키/프로젝트를 채웁니다.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
