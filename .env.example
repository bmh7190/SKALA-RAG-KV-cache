# InfiniGen 조사에 사용할 생성 LLM. 현재 구현된 제공자는 openai이며 모델명은 사용자가 지정합니다.
LLM_PROVIDER=
LLM_MODEL=

# 공개 로컬 임베딩. 사용자 지정 모델이며 dense 검색에 사용합니다.
EMBEDDING_MODEL=BAAI/bge-m3

# OpenAI를 생성 LLM으로 선택할 때만 필요합니다.
OPENAI_API_KEY=

# Tavily 웹 검색 기능을 구현하고 사용할 때만 필요합니다.
TAVILY_API_KEY=

# 최종 PDF 경로. 비워 두면 output/pdf/kv_cache_evaluation_report.pdf를 사용합니다.
REPORT_PDF_PATH=
# 자동 탐색되는 한글 TTF가 없을 때 설치된 .ttf 파일 경로를 지정합니다.
REPORT_FONT_PATH=

# LangSmith 추적은 선택 사항입니다. 켤 때만 키/프로젝트를 채웁니다.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
